# Copy this file to ".env" and fill in the values you have.
# Everything is optional except ANTHROPIC_API_KEY (for script writing).

# --- Claude (script generation) ---------------------------------------------
# Get a key at https://console.anthropic.com/  ->  API Keys
ANTHROPIC_API_KEY=

# --- Royalty-free stock media (optional) ------------------------------------
# Free key at https://www.pexels.com/api/  — enables extra b-roll images.
# Uma ou mais chaves, SEPARADAS POR VIRGULA numa unica linha. O codigo
# rotaciona automaticamente quando uma responde 429 (cota esgotada) ou e
# rejeitada. Chave gratuita em https://www.pexels.com/api/
PEXELS_API_KEYS=your_pexels_key_here

# --- News API (optional) ----------------------------------------------------
# The project uses free RSS feeds by default. A NewsAPI key adds more sources.
# Free key at https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here

# --- Google News search (optional, fresher + more varied stories) ------------
# Serper.dev: free keys with 2500 searches each, comma-separated. Primary tier.
SERPER_API_KEYS=key1,key2
# SerpAPI.com: reserve tier, used only after all Serper keys are exhausted.
SERPAPI_API_KEYS=key1

# --- ElevenLabs TTS (optional, human-quality voice) --------------------------
# One or more keys, comma-separated on ONE line. The tool checks each key's
# remaining credits, rotates automatically when one runs out, and falls back
# to free edge-tts when all are exhausted.
# Keys at https://elevenlabs.io/  ->  Profile  ->  API Keys
ELEVENLABS_API_KEYS=sk_first_key,sk_second_key,sk_third_key
